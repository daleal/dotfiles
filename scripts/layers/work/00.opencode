#!/usr/bin/env bash

set -euo pipefail

curl -fsSL https://opencode.ai/v2/install | bash

if [[ "$("$HOME/.opencode/bin/opencode2" service status 2>/dev/null)" != "http://127.0.0.1:4096" ]]; then
  "$HOME/.opencode/bin/opencode2" service set hostname 127.0.0.1
  "$HOME/.opencode/bin/opencode2" service set port 4096
  "$HOME/.opencode/bin/opencode2" service restart
fi
