#!/usr/bin/env bash
set -euo pipefail

SHELL_RCS=(~/.bashrc ~/.zshrc)
COMMENT='# Source shell aliases managed by dotfiles'

for rc in "${SHELL_RCS[@]}"; do
  if [[ "$rc" == */.zshrc ]]; then
    SNIPPET='for f in ~/.config/shell/aliases.d/*.sh(N); do [[ -f "$f" ]] && source "$f"; done'
  else
    SNIPPET='for f in ~/.config/shell/aliases.d/*.sh; do if [[ -f "$f" ]]; then source "$f"; fi; done'
  fi

  if ! grep -qF "$SNIPPET" "$rc" 2>/dev/null; then
    printf '\n%s\n%s\n' "$COMMENT" "$SNIPPET" >> "$rc"
  fi
done
