#!/usr/bin/env bash
set -euo pipefail

setup_zsh() {
  local zsh_bin profile zshrc begin_marker end_marker temp_file

  zsh_bin="$(command -v zsh)"

  # OS Login users are provided through NSS and cannot be changed by usermod.
  profile="$HOME/.profile"
  begin_marker='# >>> zsh login >>>'
  end_marker='# <<< zsh login <<<'

  if ! grep -qF "$begin_marker" "$profile" 2>/dev/null; then
    temp_file="$(mktemp)"
    {
      printf '%s\n' "$begin_marker"
      printf '%s\n' 'if [ -t 0 ] && [ -z "${ZSH_VERSION:-}" ]; then'
      printf '  exec "%s" -l\n' "$zsh_bin"
      printf '%s\n\n' 'fi' "$end_marker"
      [[ ! -f "$profile" ]] || cat "$profile"
    } > "$temp_file"
    cat "$temp_file" > "$profile"
    rm -f "$temp_file"
  fi

  zshrc="$HOME/.zshrc"
  begin_marker='# >>> oh-my-zsh config >>>'
  end_marker='# <<< oh-my-zsh config <<<'

  if ! grep -qF "$begin_marker" "$zshrc" 2>/dev/null; then
    temp_file="$(mktemp)"
    {
      printf '%s\n' "$begin_marker"
      cat <<'EOF'
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git)

export LANG=C.UTF-8

source "$ZSH/oh-my-zsh.sh"

# Agnoster theme customization
prompt_context() {
  prompt_segment black default 'remote'
}
EOF
      printf '%s\n\n' "$end_marker"
      [[ ! -f "$zshrc" ]] || cat "$zshrc"
    } > "$temp_file"
    cat "$temp_file" > "$zshrc"
    rm -f "$temp_file"
  fi

  if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c \
      "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  fi
}

setup_zsh
unset -f setup_zsh
