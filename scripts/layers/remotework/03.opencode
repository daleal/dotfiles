#!/usr/bin/env bash
set -euo pipefail

curl -fsSL https://opencode.ai/v2/install | bash

if [[ "$("$HOME/.opencode/bin/opencode2" service status 2>/dev/null)" != "http://0.0.0.0:4096" ]]; then
  "$HOME/.opencode/bin/opencode2" service set hostname 0.0.0.0
  "$HOME/.opencode/bin/opencode2" service set port 4096
  "$HOME/.opencode/bin/opencode2" service restart
fi
