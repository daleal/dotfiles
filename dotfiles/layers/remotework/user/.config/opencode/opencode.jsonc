{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": true,

  "formatter": {
    "eslint": {
      "command": ["bunx", "eslint", "--fix", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".sass",
        ".less",
        ".vue",
        ".svelte",
        ".json",
        ".jsonc",
        ".yaml",
        ".yml",
        ".toml",
        ".xml",
        ".md",
        ".mdx",
        ".graphql",
        ".gql"
      ]
    }
  },

  "lsp": {
    "sorbet": {
      "command": ["bundle", "exec", "srb", "tc", "--lsp", "--disable-watchman"],
      "extensions": [".rb", ".rbi"]
    },
    "ruby-lsp": { "disabled": true }
  },

  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": { "callback_port": 3118 },
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": { "callback_port": 3118 },
      },
      "figma": {
        "type": "remote",
        // Figma desktop on the Mac, reverse-forwarded by dotfiles/layers/work/user/.config/shell/aliases.d/remote.sh
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false,
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "1601185624273.8899143856786",
          "redirect_uri": "http://localhost:3118/callback",
        },
      },
    },
  },

  "permissions": [
    { "action": "subagent", "resource": "review", "effect": "deny" },
    { "action": "subagent", "resource": "pr", "effect": "deny" },
    { "action": "slack_*", "resource": "*", "effect": "deny" },
  ],

  "references": {
    "dashboard": {
      "repository": "github.com/fintoc-com/dashboard",
    },
    "fintoc-rails": {
      "repository": "github.com/fintoc-com/fintoc-rails",
    },
    "pacioli": {
      "repository": "github.com/fintoc-com/pacioli",
    },
  },

  "plugins": ["opencode-claude-auth-v2@latest"],

  "providers": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "body": {
            "provider": {
              "order": ["modal/fp8", "baseten/fp8", "makora"],
              "allow_fallbacks": false,
            },
          },
        },
      },
    },
  },
}
