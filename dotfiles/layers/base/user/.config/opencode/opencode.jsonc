{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": true,

  "formatter": {
    "eslint": {
      "command": ["bunx", "eslint", "--fix", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".sass",
        ".less",
        ".vue",
        ".svelte",
        ".json",
        ".jsonc",
        ".yaml",
        ".yml",
        ".toml",
        ".xml",
        ".md",
        ".mdx",
        ".graphql",
        ".gql"
      ]
    }
  },

  "lsp": {
    "sorbet": {
      "command": ["bundle", "exec", "srb", "tc", "--lsp", "--disable-watchman"],
      "extensions": [".rb", ".rbi"]
    },
    "ruby-lsp": { "disabled": true }
  },

  "mcp": {
    "servers": {
      "fiend": {
        "type": "remote",
        "url": "https://anoma.ly/labs/fiend/mcp",
      },
    },
  },

  "permissions": [
    { "action": "external_directory", "resource": "~/.agents/skills/*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "browser", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "review", "effect": "deny" },
  ],

  "plugins": ["opencode-claude-auth-v2@latest"],
}
