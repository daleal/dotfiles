#!/usr/bin/env bash

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$DIR")"
STOW_IGNORE='(^|/)README\.md$'

source "$REPO_DIR/lib/profile.sh"
source "$REPO_DIR/lib/linked-dirs.sh"
select_profile "$REPO_DIR" "${1:-}"

clear_conflicts() {
  local target_dir="$1"
  shift

  local output
  output="$(stow --no "$@" 2>&1 || true)"
  local conflicts
  conflicts="$(printf '%s\n' "$output" | sed -n \
    -e 's/.*existing target is not owned by stow: //p' \
    -e 's/.* over existing target \(.*\) since .*/\1/p')"

  if [[ -n "$conflicts" ]]; then
    while IFS= read -r file; do
      local full_path="$target_dir/$file"
      if [[ -e "$full_path" || -L "$full_path" ]]; then
        echo "  Removing conflicting file: $file"
        rm -f "$full_path"
      fi
    done <<< "$conflicts"
  fi
}

clear_conflicts_sudo() {
  local target_dir="$1"
  shift

  local output
  output="$(sudo stow --no "$@" 2>&1 || true)"
  local conflicts
  conflicts="$(printf '%s\n' "$output" | sed -n \
    -e 's/.*existing target is not owned by stow: //p' \
    -e 's/.* over existing target \(.*\) since .*/\1/p')"

  if [[ -n "$conflicts" ]]; then
    while IFS= read -r file; do
      local full_path="$target_dir/$file"
      if [[ -e "$full_path" || -L "$full_path" ]]; then
        echo "  Removing conflicting file: $file"
        sudo rm -f "$full_path"
      fi
    done <<< "$conflicts"
  fi
}

STOW_ARGS=(-R --no-folding --override='.*' --ignore "$STOW_IGNORE")

for layer in "${PROFILE_LAYERS[@]}"; do
  LAYER_DIR="$DIR/layers/$layer"

  if [[ ! -d "$LAYER_DIR" ]]; then
    echo ""
    echo "Warning: layer '$layer' not found, skipping." >&2
    continue
  fi

  if [[ -d "$LAYER_DIR/user" ]]; then
    echo ""
    echo "Stowing user configs from layer '$layer'..."
    ARGS=("${STOW_ARGS[@]}")
    while IFS= read -r arg; do ARGS+=("$arg"); done < <(linked_dir_ignore_args "$LAYER_DIR/user")
    clear_conflicts "$HOME" "${ARGS[@]}" -t "$HOME" -d "$LAYER_DIR" user
    stow -v "${ARGS[@]}" -t "$HOME" -d "$LAYER_DIR" user || true
    link_dirs "$LAYER_DIR/user" "$HOME" "$REPO_DIR"
  fi

  if [[ -d "$LAYER_DIR/system" ]]; then
    echo ""
    echo "Stowing system configs from layer '$layer'..."
    ARGS=("${STOW_ARGS[@]}")
    while IFS= read -r arg; do ARGS+=("$arg"); done < <(linked_dir_ignore_args "$LAYER_DIR/system")
    clear_conflicts_sudo "/" "${ARGS[@]}" -t / -d "$LAYER_DIR" system
    sudo stow -v "${ARGS[@]}" -t / -d "$LAYER_DIR" system || true
    link_dirs "$LAYER_DIR/system" "" "$REPO_DIR" sudo
  fi
done

echo ""
echo "Done! Profile '$PROFILE' installed (layers: ${PROFILE_LAYERS[*]})."
